# Certn Centric screening client — environment variables.
# Copy to .env and fill in from your Certn sandbox dashboard.
# DO NOT commit real values.

# Required — Authorization: Api-Key <key>
CERTN_API_KEY=

# Required — HMAC-SHA256 secret for X-Signature webhook verification
CERTN_WEBHOOK_SECRET=

# Optional — override the API base URL (defaults to sandbox/production by CERTN_ENVIRONMENT)
# CERTN_BASE_URL=https://api.sandbox.certn.co

# Optional — 'production' selects https://api.ca.certn.co
# CERTN_ENVIRONMENT=sandbox

# Optional — allow-listed profile name (identity|credit|risk); default 'identity'
# CERTN_PROFILE=identity

# Optional — case group
# CERTN_GROUP=

# Optional — JSON array of tags, e.g. ["tenant-screening"]
# CERTN_TAGS=[]

# Optional — applicant language (en-CA, fr-CA)
# CERTN_APPLICANT_LANGUAGE=
